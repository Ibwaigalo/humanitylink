# Neon PostgreSQL — récupérer l'URL depuis console.neon.tech (format "pooled connection")
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/humanitylink?sslmode=require"

# NextAuth
AUTH_SECRET="generer-avec-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Email provider (magic link) - à compléter selon le choix (Resend conseillé, déjà utilisé sur muscledbrains.com)
# AUTH_RESEND_KEY=""
# EMAIL_FROM="no-reply@votre-domaine-verifie.com"

# URL de base pour Auth.js (obligatoire en production, ex. https://mon-app.vercel.app)
# AUTH_URL="https://mon-app.vercel.app"
# AUTH_TRUST_HOST="true"

# Optionnel — rattacher des rôles à des adresses que vous pouvez recevoir (utile pour tester /dashboard et /admin)
# SEED_ADMIN_EMAIL="vous@exemple.com"
# SEED_ORG_EMAIL="vous+ong@exemple.com"
